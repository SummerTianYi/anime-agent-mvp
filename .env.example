LLM_PROVIDER=glm
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_MODEL=glm-5.3-flash
GLM_API_KEY=

# Optional alternative provider
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# Optional Anthropic-dialect provider (StepFun step_plan etc.). The endpoint
# must speak /v1/messages; no trailing slash on the base URL.
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan
STEPFUN_MODEL=step-3.7-flash
STEPFUN_API_KEY=

AGENT_CORE_HOST=127.0.0.1
AGENT_CORE_PORT=8765
AGENT_CORE_WS_URL=ws://127.0.0.1:8765/ws
LLM_TIMEOUT_SECONDS=45

# Avatar rendering profile. Use 1.2 or 1.1 to restore an earlier accepted look.
ANIME_AGENT_MODEL_LOOK=1.3

# Optional local storage and speech-to-text settings
ANIME_AGENT_DATA_DIR=
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Wake word ("tianyi" KWS + whisper two-stage confirm). 0 disables listening.
ANIME_AGENT_WAKE_WORD=1

# Farewell pre-synthesis: warm the three goodbye lines when the avatar
# connects so the exit line plays instantly on close. 0 disables.
ANIME_AGENT_FAREWELL_PRECACHE=1

# E-phase TTS voice (GPT-SoVITS sidecar, see docs/LOCAL_DEV.md).
# The sidecar runs in the separate tianyi-tts workspace venv; Core degrades to
# text-only chat when it is absent, so leaving ANIME_AGENT_TTS=0 is always safe.
ANIME_AGENT_TTS=0
ANIME_AGENT_TTS_NARRATE=1
TTS_SERVICE_URL=http://127.0.0.1:8770
# Codex: optional local supervisor workspace; omit to use adjacent tianyi-tts.
# TTS_WORKSPACE=D:/path/to/work/tianyi-tts

# ---- Agent capability layer (exam-gated; see docs/HANDOFF.md §3) ----

# A-phase read-only tool loop (get_time/read_file/list_dir/screenshot/
# active_window/clipboard_read). 0 disables the whole loop.
ANIME_AGENT_TOOLS=1

# Read roots for path-bearing tools, os.pathsep (; on Windows) separated.
# Leave EMPTY for a safe default (tools that need paths will refuse).
# "*" removes the restriction entirely — only on a disposable machine.
ANIME_AGENT_TOOLS_ROOTS=

# Write roots for write_file (atomic write + in-chat confirmation). Same
# format as above; empty = no write permission anywhere.
ANIME_AGENT_WRITE_ROOTS=

# run_command whitelist: comma-separated command names (e.g. python).
# Shell metacharacters are always rejected; empty = no command may run.
ANIME_AGENT_ALLOWED_COMMANDS=

# MCP servers: entries "name=command args", os.pathsep separated, e.g.
#   ANIME_AGENT_MCP_SERVERS=exam=python scripts/test_mcp_server.py
# MCP tools merge into the schema as mcp__<server>__<tool> on the ask tier.
ANIME_AGENT_MCP_SERVERS=

# Screen vision model for look_at_screen (privacy ask-tier). Unset = the
# tool degrades gracefully to a stated boundary. PROTOCOL selects the request
# dialect: openai (chat/completions + image_url) or anthropic (/v1/messages
# + base64 image blocks, e.g. StepFun step_plan).
ANIME_AGENT_VISION_BASE_URL=
ANIME_AGENT_VISION_KEY=
ANIME_AGENT_VISION_MODEL=
ANIME_AGENT_VISION_PROTOCOL=

# Proactive greeting: quiet hours (24h) and cooldown seconds.
ANIME_AGENT_QUIET_START=23:00
ANIME_AGENT_QUIET_END=08:00
ANIME_AGENT_PROACTIVE_COOLDOWN=3600

# Idle trigger (D-phase): speak a care line from the local template bank after
# this much system-wide keyboard/mouse inactivity. Pure local logic - standby
# costs zero LLM quota. 0 disables. Cooldown = min gap between idle lines.
ANIME_AGENT_IDLE_THRESHOLD=1200
ANIME_AGENT_IDLE_COOLDOWN=3600
